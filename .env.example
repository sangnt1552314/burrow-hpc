# HPIT configuration. Copy to .env and keep it private:
#   cp .env.example .env && chmod 600 .env
# Point HPIT at this file (add to ~/.bashrc):
#   export HPIT_ENV_FILE=/path/to/hpit/.env
# Real environment variables override values in this file.

# NUS account password, used only to run `amgr login` when the
# accounting token has expired (for project credits / GPU-hours).
# Leave empty to log in manually with `hpit login` or `amgr login`.
# HPIT ignores this if the file is readable by other users.
HPIT_AMGR_PASSWORD=

# Optional settings (defaults shown)
# HPIT_CLUSTER_NAME=Hopper
# HPIT_SCRATCH=/scratch/$USER
# HPIT_REFRESH_INTERVAL=60
# HPIT_LOG_LINES=200
# HPIT_MOCK=0
# HPIT_DEBUG=0
